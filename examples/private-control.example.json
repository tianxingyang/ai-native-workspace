    { "id": "agent-trial", "kind": "agent", "name": "Trial agent", "tokenEnv": "COSEAT_AGENT_TOKEN", "tokenExpiresAt": 0, "scopes": [{ "conversationId": "trial-room", "threadId": "research" }] }
