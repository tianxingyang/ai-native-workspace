{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoSeat Demo",
  "version": "0.1.3",
  "identifier": "tech.anewell.coseat.demo",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "beforeDevCommand": "npm run desktop:prepare",
    "frontendDist": "../web"
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["coseat-demo-notice"] } } },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "create": false, "title": "CoSeat 同席 · 本地模拟版", "width": 1160, "height": 800, "minWidth": 390, "minHeight": 560, "devtools": false, "incognito": true }],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset:; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "人与 Agent 同席的本地模拟 IM",
    "resources": { "../.desktop/runtime/": "runtime/" },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false }
    }
  }
}
