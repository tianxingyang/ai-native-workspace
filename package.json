{
  "name": "coseat-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "npm run check:desktop-resources && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js web-test/*.test.mjs scripts/*.test.mjs",
    "demo": "npm run build && node dist/scripts/demo.js",
    "dev:control": "node dist/src/control/main.js --dev-fixture",
    "dev:worker": "node dist/src/worker/main.js --dev-fixture",
    "private:control": "node dist/src/private/control-main.js",
    "private:worker": "node dist/src/private/worker-main.js",
    "private:backup": "node dist/scripts/backup.js",
    "demo:private": "npm run build && node dist/scripts/private-demo.js",
    "demo:im": "npm run build && node dist/scripts/web-demo.js",
    "check:web": "node --check web/app.js && node --check web/client.js && node --check web/pending-store.js && node --check web/attachments.js && node --check web/leave-conversation.js && node --check web/conversation-management.js && node --check web/presentation.js && node --check web/locales/zh-CN.js",
    "test:presentation": "node --test web-test/presentation.test.mjs",
    "check:desktop-resources": "node scripts/desktop-resources.mjs --check",
    "desktop:resources": "node scripts/desktop-resources.mjs --write",
    "test:desktop-resources": "node --test scripts/desktop-resources.test.mjs",
    "test:browser": "npm run build && playwright test",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:build": "tauri build",
    "desktop:dev": "tauri dev"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
